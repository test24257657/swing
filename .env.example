# Shared infra — copied by both apps. Never commit the real .env.

# Postgres
POSTGRES_USER=swing
POSTGRES_PASSWORD=swing
POSTGRES_DB=swing
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://swing:swing@localhost:5432/swing

# Redis
REDIS_URL=redis://localhost:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
ENV=development

# Gemini — news AI classification (Phase 7). Leave blank to disable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Ingestion
# How far back sync_symbols / bhavcopy backfill should reach on first run
INGEST_BACKFILL_DAYS=250
# Directory where raw source responses are cached so recompute never re-hits NSE
RAW_CACHE_DIR=./data/raw_cache
