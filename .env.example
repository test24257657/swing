# Shared infra — copied by both apps. Never commit the real .env.

# Postgres
POSTGRES_USER=swing
POSTGRES_PASSWORD=swing
POSTGRES_DB=swing
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://swing:swing@localhost:5432/swing

# Redis
REDIS_URL=redis://localhost:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
ENV=development

# Gemini — news classification, AI stock narrative, weekly outlook. Leave blank to disable.
GEMINI_API_KEY=
# Optional second key — a 429 on the first key rotates to this one before backing off,
# since a separate key has its own separate quota. Leave blank to use just one key.
GEMINI_API_KEY_FALLBACK=
GEMINI_MODEL=gemini-3.6-flash
# Stock chat — AI questions per user per IST day (shares the free Gemini quota).
CHAT_DAILY_LIMIT=20

# mem0 — weekly outlook's cross-week memory. Leave blank to disable (outlook still
# generates, it just starts fresh every week instead of grading its own last call).
MEM0_API_KEY=

# Ingestion
# How far back sync_symbols / bhavcopy backfill should reach on first run
INGEST_BACKFILL_DAYS=250
# Directory where raw source responses are cached so recompute never re-hits NSE
RAW_CACHE_DIR=./data/raw_cache
