DATABASE_URL=postgresql+psycopg://swing:swing@localhost:5432/swing
REDIS_URL=redis://localhost:6379/0
ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
INGEST_BACKFILL_DAYS=250
RAW_CACHE_DIR=./data/raw_cache
# Comma-separated origins allowed by CORS
CORS_ORIGINS=http://localhost:3000

# Gemini — news impact classification + AI summaries (Phase 7). Leave blank to disable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Auth — set a strong SECRET_KEY in production; seed the admin with `python -m app.auth.seed`
SECRET_KEY=change-me
ADMIN_EMAIL=
ADMIN_PASSWORD=
