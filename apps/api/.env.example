# Local dev — copy to apps/api/.env and fill DATABASE_URL. .env is gitignored.

# Neon Postgres (users/auth only — no market data). psycopg form:
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require

# Optional — Redis is reserved for a later phase; the app runs without it.
REDIS_URL=redis://localhost:6379/0

ENV=development
LOG_LEVEL=INFO

# Where the API reads the nightly artifacts from. Default: <repo-root>/out
# OUT_DIR=../../out

# Auth
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_EMAIL=admin123@gmail.com
ADMIN_PASSWORD=admin@1234567890

# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:3000
