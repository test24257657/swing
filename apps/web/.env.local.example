# Base URL the browser uses to reach the API. Default proxies through Next (/api -> :8000).
NEXT_PUBLIC_API_BASE=/api
# Where the Next rewrite proxies to (server-side only).
API_PROXY_TARGET=http://localhost:8000
# Public origin — drives SEO metadataBase, canonical URLs, sitemap and robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
