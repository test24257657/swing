# Local dev — copy to apps/web/.env.local

# Where the browser reaches the API.
#   local:  /api          (proxied to API_PROXY_TARGET by next.config.mjs)
#   prod:   https://swing-api.onrender.com   (set in the Vercel dashboard)
NEXT_PUBLIC_API_BASE=/api
API_PROXY_TARGET=http://localhost:8000

# Public origin — drives SEO canonical URLs, sitemap, robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
